DATABASE_URL=postgresql+psycopg://jobintel:jobintel@localhost:5432/jobintel
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_PROVIDER=openai
AI_MODEL=gpt-5.6
OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ai-job-intelligence.local
SMTP_USE_TLS=true

# Job discovery is disabled until both of these are set. Pick a company
# Greenhouse board AJI has permission to ingest (see
# services/job_discovery/README.md) - do not set these to a board without
# that permission.
JOB_DISCOVERY_GREENHOUSE_BOARD_TOKEN=
JOB_DISCOVERY_GREENHOUSE_COMPANY_NAME=
# Shared secret required in the `X-Discovery-Trigger-Token` header on
# POST /internal/job-discovery/run. Generate a long random value; this is
# a system credential for your scheduler (cron/CI), never given to users.
JOB_DISCOVERY_TRIGGER_TOKEN=

# TheirStack job discovery provider (AJI-021) - a second, independently
# enabled source alongside Greenhouse. Disabled by default. See
# services/job_discovery/README.md for the real-local-run instructions.
# Server-side only - THEIRSTACK_API_KEY must never be exposed to the
# frontend, logged, stored in the database, or committed to git.
THEIRSTACK_ENABLED=false
THEIRSTACK_API_KEY=
# Hard ceiling on jobs fetched per discovery run - discovery never pulls
# an unbounded number of results.
THEIRSTACK_MAX_RESULTS=50
THEIRSTACK_PAGE_SIZE=25
THEIRSTACK_TIMEOUT_SECONDS=15
# Bounded retries for transient failures only (timeouts/5xx/429) -
# authentication/config errors are never retried.
THEIRSTACK_MAX_RETRIES=2
# TheirStack requires at least one search filter per request; this lets
# discovery run without pinning to a specific company.
THEIRSTACK_POSTED_AT_MAX_AGE_DAYS=7
# Optional comma-separated job title filter, e.g. "Software Engineer,Data Scientist".
THEIRSTACK_JOB_TITLES=
# Comma-separated country codes. Defaults to US since the existing
# validator only accepts United States jobs today.
THEIRSTACK_COUNTRY_CODES=US