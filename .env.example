DATABASE_URL=postgresql+psycopg://jobintel:jobintel@localhost:5432/jobintel
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# AI_MODEL must be a real OpenAI API model id, not the bare "gpt-5.6"
# family alias - that alias routes to GPT-5.6 Sol, the flagship
# frontier-reasoning tier, whose default reasoning pass can push
# response time past this app's client-side AI request timeout. Terra
# is OpenAI's recommended tier for bounded-latency structured tasks
# like resume/job/gap/requirement analysis.
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ai-job-intelligence.local
SMTP_USE_TLS=true

# Job discovery is disabled until both of these are set. Pick a company
# Greenhouse board AJI has permission to ingest (see
# services/job_discovery/README.md) - do not set these to a board without
# that permission.
JOB_DISCOVERY_GREENHOUSE_BOARD_TOKEN=
JOB_DISCOVERY_GREENHOUSE_COMPANY_NAME=
# Shared secret required in the `X-Discovery-Trigger-Token` header on
# POST /internal/job-discovery/run. Generate a long random value; this is
# a system credential for your scheduler (cron/CI), never given to users.
JOB_DISCOVERY_TRIGGER_TOKEN=

# Discovery provider selection (AJI-024). Leave unset to use Greenhouse
# when the board settings above are present. "test_fixture" runs the
# deterministic, clearly-labelled synthetic provider for local development
# and tests ONLY - it also requires JOB_DISCOVERY_ENABLE_TEST_PROVIDER=true.
# "development_dataset" (AJI-030) runs the realistic, synthetic U.S.
# development dataset under the same flag. Neither is a production provider.
# Never enable a test provider in production.
JOB_DISCOVERY_PROVIDER=
JOB_DISCOVERY_ENABLE_TEST_PROVIDER=false
